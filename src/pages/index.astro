---
import Layout from '../layouts/Layout.astro';
import { getNotes } from '../utils/notes';
import Graph, { type NoteNode, type GraphLink } from '../components/Graph.astro';
import { renderMarkdownToHtml } from '../utils/markdown';
import { readLocalMarkdown, fetchWithHeaders } from '../utils/content.ts';

const notes = await getNotes();
const noteMap = new Map(notes.map((n) => [n.slug, n]));

const graphSlugs = new Set<string>();
const rawLinks: { source: string; target: string }[] = [];

try {
	const localGraph = readLocalMarkdown('graph');
	const graphSource = localGraph || (await (await fetchWithHeaders('https://files.obsidianos.xyz/~robin/blog/content/graph.md')).text());
	const lines = graphSource.split('\n');
	for (const line of lines) {
		const match = line.match(/^(.+?)\s*->\s*(.+)$/);
		if (match) {
			const source = match[1].trim().replace(/^\/+/, '').replace(/\.md$/, '');
			const target = match[2].trim().replace(/^\/+/, '').replace(/\.md$/, '');
			graphSlugs.add(source);
			graphSlugs.add(target);
			rawLinks.push({ source, target });
		}
	}
} catch (e) {
	console.error('Failed to load graph.md:', e);
}

const nodes: NoteNode[] = notes.map((n) => ({ id: n.slug, title: n.title, excerpt: n.excerpt }));
for (const slug of graphSlugs) {
	if (!noteMap.has(slug)) {
		nodes.push({ id: slug, title: slug, excerpt: '' });
	}
}

const nodeIds = new Set(nodes.map((n) => n.id));
const links: GraphLink[] = rawLinks.filter((l) => nodeIds.has(l.source) && nodeIds.has(l.target));

let homeConfig = {
	title: 'Second Brain',
	description: 'Knowledge graph of all notes',
	contentHtml: '',
};

const localHome = readLocalMarkdown('home');
if (localHome) {
	const frontmatterMatch = localHome.match(/^---\s*\n([\s\S]*?)\n---/);
	if (frontmatterMatch) {
		const fm = frontmatterMatch[1];
		const titleMatch = fm.match(/^title:\s*(.+)$/m);
		if (titleMatch) homeConfig.title = titleMatch[1].trim().replace(/['"]/g, '');
		const descMatch = fm.match(/^description:\s*(.+)$/m);
		if (descMatch) homeConfig.description = descMatch[1].trim().replace(/['"]/g, '');
	}
	homeConfig.contentHtml = renderMarkdownToHtml(localHome, '/blog');
} else {
	try {
		const res = await fetchWithHeaders('https://files.obsidianos.xyz/~robin/blog/content/home.md');
		if (res.ok) {
			const content = await res.text();
			const frontmatterMatch = content.match(/^---\s*\n([\s\S]*?)\n---/);
			if (frontmatterMatch) {
				const fm = frontmatterMatch[1];
				const titleMatch = fm.match(/^title:\s*(.+)$/m);
				if (titleMatch) homeConfig.title = titleMatch[1].trim().replace(/['"]/g, '');
				const descMatch = fm.match(/^description:\s*(.+)$/m);
				if (descMatch) homeConfig.description = descMatch[1].trim().replace(/['"]/g, '');
			}
			homeConfig.contentHtml = renderMarkdownToHtml(content, '/blog');
		}
	} catch (e) {
		console.error('Failed to load home.md:', e);
	}
}
---

<Layout title={homeConfig.title} description={homeConfig.description}>
	<section class="wrap section">
		<header class="section-head">
			<p class="label">// second brain</p>
			<h2 class="display section-title">{homeConfig.title}</h2>
		</header>
		{homeConfig.contentHtml && (
			<div class="prose" set:html={homeConfig.contentHtml} style="margin-bottom: 2rem;" />
		)}
		<Graph {nodes} {links} />
	</section>
</Layout>
